rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yardımcı fonksiyonlar
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isBarber() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/barbers/$(request.auth.uid));
    }
    
    function isCustomer() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }
    
    // Berberler koleksiyonu
    match /barbers/{barberId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == barberId;
      
      // Berber hizmetleri
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == barberId;
      }
    }
    
    // Hizmetler koleksiyonu
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isBarber();
    }
    
    // Randevular koleksiyonu
    match /appointments/{appointmentId} {
      // Tüm giriş yapmış kullanıcılar randevuları okuyabilir
      allow read: if true;
      
      // Yeni randevu oluşturma
      allow create: if isAuthenticated();
      
      // Randevu güncelleme ve silme
      allow update, delete: if isAuthenticated() && (
        resource.data.barberId == request.auth.uid || 
        resource.data.customerId == request.auth.uid
      );
    }
    
    // Müşteriler koleksiyonu
    match /customers/{customerId} {
      allow read, write: if isAuthenticated() && 
        request.auth.uid == customerId;
    }
  }
} 